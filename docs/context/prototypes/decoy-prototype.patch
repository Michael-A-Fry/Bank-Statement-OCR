diff -ruN snap20/R/auto_read_blocks.R nrg_decoy/proto/R/auto_read_blocks.R
--- snap20/R/auto_read_blocks.R	1970-01-01 00:00:00.000000000 +0000
+++ nrg_decoy/proto/R/auto_read_blocks.R	2026-10-04 03:52:10.692463741 +0000
@@ -0,0 +1,316 @@
+# auto_read_blocks.R -- PROTOTYPE (decoy diagnosis, /tmp/nrg_decoy). Not shipped.
+#
+# A statement pack prints other tables beside the statement's own: rate tables,
+# pending items, schedules, another account's mini-statement. The whole-document
+# column model (.ar_model) takes every dated line with a figure as a row of ONE
+# table, so those tables' rows and columns are mixed in and nothing proves.
+#
+# Here each page is cut into TABLE BLOCKS: runs of dated lines with a figure,
+# with the dateless rows, summary lines and wrapped lines that touch them; a
+# heading, a title, a paragraph or a blank band ends a block. Blocks with the same
+# date column and compatible figure columns form a cluster (one table across its
+# pages). Each cluster is read ON ITS OWN (the other blocks set aside), and the
+# arithmetic decides. The statement's own table is the largest cluster; it is
+# taken only when it proves, and a set-aside table is allowed only when the
+# statement's own printed opening and closing balances close over the rows read.
+# Another cluster that proves on its own is another account: reported separately,
+# labelled, never mixed in.
+
+.AR_BLOCK_MAX_CLUSTERS <- 4L
+.AR_BLOCK_MAX_RUNS <- 6L
+.AR_ACCT_RX <- "\\b(?:[0-9]{2}-[0-9]{4}-[0-9]{7}-[0-9]{2,3}|TD-[0-9]{4,})\\b"
+.AR_OTHER_ACCT_RX <- "(?i)linked account|for information only|not part of this statement|not included in (the|your) (balance|statement)|reported in full on its own|recent activity|activity this period|transactions this period|mini-?statement"
+
+# .ar_blocks(pgs) -- every table block on every page, in document order.
+.ar_blocks <- function(pgs) {
+  out <- list()
+  for (pg in pgs) {
+    if (is.null(pg) || !nrow(pg$ph)) next
+    seeds <- .ar_seed_lines(pg)
+    ln <- pg$lines; ph <- pg$ph; w <- pg$w; h <- pg$h
+    nl <- nrow(ln)
+    is_seed <- ln$line %in% seeds
+    sm <- ph[ph$kind == "money" & ph$standalone, , drop = FALSE]
+    has_money <- ln$line %in% sm$line
+    has_date <- ln$line %in% ph$line[ph$kind == "date"]
+    anchor <- ln$summary & ln$line %in% ph$line[ph$kind == "money"]
+    bodyish <- has_money & !ln$summary
+    sd <- ph[ph$kind == "date" & ph$line %in% seeds, , drop = FALSE]
+    sd <- sd[!duplicated(sd$line), , drop = FALSE]
+    wl <- split(seq_len(nrow(w)), w$line)
+    minx <- vapply(as.character(ln$line), function(l) min(w$x[wl[[l]]]), 0)
+    textonly <- vapply(as.character(ln$line), function(l) !any(w$kind[wl[[l]]] %in% c("money", "date")), logical(1))
+    sx <- which(is_seed)
+    pitch <- if (length(sx) >= 2L) stats::median(diff(ln$y[sx])) else 2 * h
+    pitch <- min(max(pitch, 1.2 * h), 2.4 * h)
+    used <- rep(FALSE, nl)
+    prev_last <- 0L
+    for (i0 in sx) {
+      if (used[i0]) next
+      dx <- sd$x[sd$line == ln$line[i0]][1]; dx1 <- sd$x1[sd$line == ln$line[i0]][1]
+      first <- i0; last <- i0
+      while (first > 1L && !used[first - 1L] && (bodyish[first - 1L] || anchor[first - 1L]) &&
+             !(has_date[first - 1L] && !is_seed[first - 1L] && !anchor[first - 1L]) &&
+             ln$y[first] - ln$y[first - 1L] <= 2.5 * pitch) first <- first - 1L
+      while (last < nl) {
+        nx <- last + 1L
+        if (used[nx]) break
+        cont <- textonly[nx] && !ln$footer[nx] && !ln$summary[nx] && minx[nx] > dx1 + 2 &&
+                ln$y[nx] - ln$y1[last] <= 1.2 * h && !anchor[last]
+        same_dcol <- function() { d2 <- sd$x[sd$line == ln$line[nx]][1]; isTRUE(abs(d2 - dx) <= 3) }
+        row_ok <- (is_seed[nx] && same_dcol()) || (bodyish[nx] && !has_date[nx]) || anchor[nx]
+        ok <- cont || (row_ok && ln$y[nx] - ln$y[last] <= 2.5 * pitch)
+        if (!ok) break
+        last <- nx
+      }
+      while (last > i0 && textonly[last] && !anchor[last]) last <- last - 1L
+      ix <- first:last
+      used[ix] <- TRUE
+      bseeds <- ln$line[ix][is_seed[ix]]
+      m <- sm[sm$line %in% bseeds, , drop = FALSE]
+      e <- if (nrow(m)) { g <- .ar_cluster(m$x1, 2); as.numeric(tapply(m$x1, g, stats::median)) } else numeric(0)
+      out[[length(out) + 1L]] <- list(page = pg$page, lines = ln$line[ix], seeds = bseeds,
+        y0 = ln$y[first], y1 = ln$y1[last], date_x = dx, date_x1 = dx1, edges = sort(e),
+        first_i = first, title = "")
+      prev_last <- last
+    }
+    # Figure tables: runs of the remaining lines that print figures, one of them
+    # two or more figures apart (an account summary, a tax or rate table), with the
+    # total lines under them. Never read as the statement; always set aside, so a
+    # total printed under one is never taken as the statement's own.
+    nfig <- vapply(ln$line, function(l) sum(sm$line == l), 0L)
+    if (nzchar(Sys.getenv("NRG_NO_FIG"))) nfig[] <- 0L
+    i <- 1L
+    while (i <= nl) {
+      if (used[i] || nfig[i] == 0L) { i <- i + 1L; next }
+      j <- i
+      while (j < nl && !used[j + 1L] && nfig[j + 1L] > 0L && ln$y[j + 1L] - ln$y[j] <= 2.5 * pitch) j <- j + 1L
+      ix <- i:j
+      # ... or a list of three or more lines, each with one figure on a shared right
+      # edge and none of them a balance or total line (a fee schedule; a summary
+      # box of opening and closing balances is the statement's own and stays).
+      edge1 <- vapply(ix, function(q) max(sm$x1[sm$line == ln$line[q]]), 0)
+      list1 <- length(ix) >= 3L && !any(ln$summary[ix]) && diff(range(edge1)) <= 2
+      if (any(nfig[ix] >= 2L & !ln$summary[ix]) || list1) {
+        used[ix] <- TRUE
+        out[[length(out) + 1L]] <- list(page = pg$page, lines = ln$line[ix], seeds = integer(0),
+          y0 = ln$y[i], y1 = ln$y1[j], date_x = NA_real_, date_x1 = NA_real_, edges = numeric(0),
+          title = "", figure_only = TRUE)
+      }
+      i <- j + 1L
+    }
+    # The title zone of each dated table: up to 6 lines above it, stopping at any
+    # line of another table (a summary table above is not its title).
+    for (q in seq_along(out)) {
+      b <- out[[q]]
+      if (b$page != pg$page || isTRUE(b$figure_only)) next
+      tz <- integer(0); r <- b$first_i - 1L
+      while (r >= 1L && length(tz) < 6L && !used[r]) { tz <- c(r, tz); r <- r - 1L }
+      out[[q]]$title <- paste(ln$raw[tz], collapse = " / ")
+    }
+  }
+  out
+}
+
+# .ar_block_compat(a, b) -- the same table's columns: the same date column, and the
+# figure columns of one a subset of the other's (a page without deposits prints
+# fewer), allowing one stray figure edge in the smaller.
+.ar_block_compat <- function(core, b, tol = 2) {
+  if (abs(core$date_x - b$date_x) > tol) return(FALSE)
+  ec <- core$edges; eb <- b$edges
+  if (!length(ec) || !length(eb)) return(FALSE)
+  # A table titled as another account's is never a page of this one.
+  if (grepl(.AR_OTHER_ACCT_RX, b$title, perl = TRUE)) return(FALSE)
+  # A block joins the core's table when every figure column it prints is one of the
+  # core's (a page without deposits prints fewer); a table with a column the core
+  # does not have is another table.
+  all(vapply(eb, function(v) any(abs(v - ec) <= 1.5), logical(1)))
+}
+
+# .ar_block_clusters(blocks) -- each block joins the cluster of the largest block it
+# is compatible with; returns the cluster index per block, clusters numbered by
+# size (dated rows), largest first.
+.ar_block_clusters <- function(blocks) {
+  ns <- vapply(blocks, function(b) length(b$seeds), 0)
+  ord <- order(-ns, seq_along(blocks))
+  cl <- integer(length(blocks)); k <- 0L
+  for (i in ord) {
+    if (cl[i]) next
+    k <- k + 1L; cl[i] <- k
+    for (j in ord) if (!cl[j] && .ar_block_compat(blocks[[i]], blocks[[j]])) cl[j] <- k
+  }
+  tot <- tapply(ns, cl, sum)
+  rk <- rank(-tot, ties.method = "first")
+  as.integer(rk[as.character(cl)])
+}
+
+.ar_keep_list <- function(blocks, idx) {
+  out <- list()
+  for (i in idx) { p <- as.character(blocks[[i]]$page); out[[p]] <- c(out[[p]], blocks[[i]]$lines) }
+  out
+}
+
+# .ar_block_runs(members, core) -- the runs of a cluster's blocks (document order)
+# that hold its largest block: the whole cluster first, then shorter runs.
+.ar_block_runs <- function(members, core) {
+  k <- length(members); c0 <- match(core, members)
+  runs <- list()
+  for (len in k:1) for (i in seq_len(k - len + 1L)) {
+    j <- i + len - 1L
+    if (i <= c0 && j >= c0) runs[[length(runs) + 1L]] <- members[i:j]
+  }
+  utils::head(runs, .AR_BLOCK_MAX_RUNS)
+}
+
+# .ar_block_reading(ctx, base) -- read the clusters one at a time. Returns the main
+# candidate (or NULL), the other accounts that prove on their own, and notes.
+.ar_block_reading <- function(ctx, base) {
+  allb <- .ar_blocks(base)
+  fig <- vapply(allb, function(b) isTRUE(b$figure_only), logical(1))
+  figb <- allb[fig]
+  blocks <- allb[!fig]
+  if (length(blocks) < 2L && !length(figb)) return(NULL)
+  if (!length(blocks)) return(NULL)
+  cl <- .ar_block_clusters(blocks)
+  ns <- vapply(blocks, function(b) length(b$seeds), 0)
+  tot <- tapply(ns, cl, sum)
+  if (length(tot) < 2L && !length(figb)) return(NULL)
+  fig_aside <- .ar_keep_list(figb, seq_along(figb))
+  key <- function(cd) if (is.null(cd$tx) || !nrow(cd$tx)) "" else paste(cd$tx$date, sprintf("%.2f", cd$tx$amount), collapse = "|")
+  res <- list()
+  # The largest clusters, and every cluster that prints its own opening or closing
+  # balance (another account's mini-statement is read on its own too).
+  has_ends <- vapply(seq_along(tot), function(k) any(vapply(which(cl == k), function(i) {
+    b <- blocks[[i]]; pg <- base[[b$page]]
+    any(pg$lines$aclass[pg$lines$line %in% b$lines] %in% c("open", "close")) }, logical(1))), logical(1))
+  todo <- sort(unique(c(seq_len(min(.AR_BLOCK_MAX_CLUSTERS, length(tot))), utils::head(which(has_ends), 12L))))
+  for (k in todo) {
+    mem <- which(cl == k)
+    if (sum(ns[mem]) < 2L) next
+    core <- mem[which.max(ns[mem])]
+    best <- NULL; passed <- list(); attempts <- list()
+    # A block of the statement's own design may be set aside only when it is not a
+    # transaction table in its own right: no opening or closing balance printed in
+    # it, and no running balance that steps with its figures (a page of this
+    # statement, or another account printed in the same design, has both).
+    own_table <- list()
+    is_own_table <- function(i) {
+      key <- as.character(i)
+      if (!is.null(own_table[[key]])) return(own_table[[key]])
+      b <- blocks[[i]]; pg <- base[[b$page]]
+      v <- any(pg$lines$aclass[pg$lines$line %in% b$lines] %in% c("open", "close"))
+      if (!v) {
+        mo <- list(keep = .ar_keep_list(blocks, i), aside = .ar_keep_list(blocks, setdiff(seq_along(blocks), i)))
+        for (pp in names(fig_aside)) mo$aside[[pp]] <- c(mo$aside[[pp]], fig_aside[[pp]])
+        cd1 <- tryCatch(.ar_pdf_attempt(ctx, base, mo, "alone", model = .ar_model(base, mo)), error = function(e) NULL)
+        # Every balance step holding (a coincidence in a table of limits or rates
+        # holds one step at most among several that fail).
+        v <- isTRUE(cd1$proof$kind == "chain") && isTRUE(cd1$proof$held >= 1L) &&
+             isTRUE(cd1$proof$held == cd1$proof$links)
+      }
+      own_table[[key]] <<- v
+      v
+    }
+    for (run in .ar_block_runs(mem, core)) {
+      dropped <- setdiff(mem, run)
+      if (length(dropped) && any(vapply(dropped, is_own_table, logical(1)))) {
+        attempts[[length(attempts) + 1L]] <- list(source = sprintf("blocks:%d:%s", k, paste(run, collapse = "+")),
+          failing = "refused", why = "A block of the same design set aside is a transaction table in its own right.")
+        next
+      }
+      aside <- .ar_keep_list(blocks, setdiff(seq_along(blocks), run))
+      for (pp in names(fig_aside)) aside[[pp]] <- c(aside[[pp]], fig_aside[[pp]])
+      mopts <- list(keep = .ar_keep_list(blocks, run), aside = aside)
+      bm <- .ar_model(base, mopts)
+      # The account type (card or loan?) is read from this table's own pages, never
+      # from another table's print or the pack's other pages (a fee schedule's
+      # "Cash advance (credit card)" does not make an everyday account a card).
+      ctx_b <- ctx
+      if (!is.null(bm) && !nzchar(Sys.getenv("NRG_NO_LIAB"))) ctx_b$liab <- .ar_liability_evidence(.ar_block_outside_text(bm))
+      cd <- .ar_pdf_attempt(ctx_b, base, mopts, sprintf("blocks:%d:%s", k, paste(run, collapse = "+")),
+                            model = bm)
+      cd$block_run <- run; cd$cluster <- k
+      # Several accounts in one reading (a combined statement) only from the whole
+      # cluster, and never when a block is titled as another account's.
+      if (isTRUE(cd$passed) && isTRUE((cd$chain$sections %||% 1L) > 1L) &&
+          any(vapply(blocks[run], function(b) grepl(.AR_OTHER_ACCT_RX, b$title, perl = TRUE), logical(1)))) {
+        cd$passed <- FALSE; cd$failing <- c(cd$failing, "sections_mixed")
+        cd$why <- "The table reads as several accounts, and not every one is this statement's."
+      }
+      attempts[[length(attempts) + 1L]] <- list(source = cd$source, failing = cd$failing, why = cd$why)
+      if (isTRUE(cd$passed)) passed[[length(passed) + 1L]] <- cd
+      if (is.null(best) || length(cd$failing %||% 99) < length(best$failing %||% 99)) best <- cd
+    }
+    keys <- unique(vapply(passed, key, ""))
+    shown <- if (length(passed)) passed[[1]] else best
+    run1 <- if (length(passed)) passed[[1]]$block_run[1] else min(mem)
+    res[[k]] <- list(in_period = .ar_in_period_rows(shown$tx, ctx$md), run_title = blocks[[run1]]$title,k = k, size = unname(tot[k]), best = best, passed = passed, unique = length(keys) == 1L,
+                     attempts = attempts,
+                     title = blocks[[core]]$title, first_title = blocks[[min(mem)]]$title,
+                     accts = unique(unlist(regmatches(blocks[[run1]]$title, gregexpr(.AR_ACCT_RX, blocks[[run1]]$title, perl = TRUE)))))
+  }
+  res <- Filter(Negate(is.null), res)
+  if (!length(res)) return(NULL)
+  # The statement's own table is the one with the most rows dated inside the
+  # statement period (a loan schedule runs into the future, a rate history into the
+  # past); then the largest. A tie is not decided.
+  ip <- vapply(res, function(r) r$in_period, 0); sz <- vapply(res, function(r) r$size, 0)
+  o <- order(-ip, -sz)
+  res <- res[o]
+  main <- res[[1]]
+  notes <- character(0)
+  tie <- length(res) > 1L && ip[o[2]] == ip[o[1]] && sz[o[2]] == sz[o[1]]
+  holder <- .ar_holder_numbers(ctx$pages_text)
+  others <- list()
+  for (r in res[-1]) if (length(r$passed) && r$unique) {
+    cd <- r$passed[[1]]
+    others[[length(others) + 1L]] <- list(account = if (length(r$accts)) r$accts[1] else NA_character_,
+      title = r$run_title, rows = nrow(cd$tx), tx = cd$tx, proof = cd$proof, why = cd$why)
+  }
+  pick <- NULL; why <- NULL
+  named <- unique(unlist(regmatches(main$run_title, gregexpr(.AR_ACCT_RX, main$run_title, perl = TRUE))))
+  foreign <- length(named) && length(holder) && !any(named %in% holder)
+  if (length(main$passed) && main$unique && !tie) {
+    if (grepl(.AR_OTHER_ACCT_RX, main$run_title, perl = TRUE) || foreign) {
+      why <- "The table that proves is titled as another account's; which table is this statement's own is not clear."
+    } else {
+      pick <- main$passed[[1]]
+      pick$why <- paste(pick$why, sprintf("Read on its own: %d other table(s) in the file were set aside.",
+                                          length(unique(cl)) - 1L))
+    }
+  } else if (length(main$passed) && !main$unique) {
+    why <- "The statement's table reads more than one way when the other tables are set aside."
+  } else if (tie) why <- "Two tables of the same size each look like the statement's own."
+  list(pick = pick, show = main$best, others = others, why = why, n_blocks = length(blocks),
+       n_clusters = length(tot), clusters = res)
+}
+
+# .ar_block_outside_text(model) -- the print on this table's own pages outside its
+# rows and outside every set-aside table.
+.ar_block_outside_text <- function(model) {
+  pages <- unique(model$rows$page)
+  unlist(lapply(Filter(function(pg) !is.null(pg) && pg$page %in% pages, model$pgs), function(pg) {
+    rg <- model$regions[[as.character(pg$page)]]
+    drop <- c(rg$lines %||% integer(0), model$aside[[as.character(pg$page)]] %||% integer(0))
+    pg$lines$raw[!(pg$lines$line %in% drop)]
+  }))
+}
+
+# .ar_in_period_rows(tx, md) -- how many rows are dated inside the printed period.
+.ar_in_period_rows <- function(tx, md) {
+  if (is.null(tx) || !nrow(tx)) return(0)
+  d <- suppressWarnings(as.Date(tx$date))
+  per <- md$periods %||% list(c(md$period_start %||% NA, md$period_end %||% NA))
+  per <- Filter(function(pp) !is.na(pp[1]) && !is.na(pp[2]) && pp[2] >= pp[1],
+                lapply(per, function(pp) c(.plausible_period_date(pp[1]), .plausible_period_date(pp[2]))))
+  if (!length(per)) return(sum(!is.na(d)))
+  sum(Reduce(`|`, lapply(per, function(pp) !is.na(d) & d >= pp[1] & d <= pp[2])))
+}
+
+# .ar_holder_numbers(pages) -- the account numbers the statement labels as its own
+# ("Account number: 06-2901-5302607-001").
+.ar_holder_numbers <- function(pages) {
+  s <- paste(pages, collapse = "\n")
+  m <- regmatches(s, gregexpr("(?i)\\b(?:account|acct)\\s*(?:number|no\\.?)\\s*:?\\s*[0-9]{2}-[0-9]{4}-[0-9]{7}-[0-9]{2,3}", s, perl = TRUE))[[1]]
+  unique(unlist(regmatches(m, gregexpr(.AR_ACCT_RX, m, perl = TRUE))))
+}
