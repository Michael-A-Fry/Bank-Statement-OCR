 #   * collapses any doubled spaces the removals leave behind
 .normalise_date_str <- function(s) {
   s <- trimws(as.character(s))
-  s <- gsub("^(mon|tue|wed|thu|fri|sat|sun)[a-z]*\\.?\\s+", "", s, perl = TRUE, ignore.case = TRUE)
